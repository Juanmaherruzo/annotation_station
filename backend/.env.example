# Copy this file to .env and adjust. Every key here is a real setting: if a
# value is not read by app/config.py it does not belong in this file.

# Storage
DATA_DIR=../data/projects
# Directory holding the SAM checkpoint. Defaults to <repo>/models if unset.
MODELS_DIR=../models

# SAM 2.1 size: tiny | small | base_plus | large
# The checkpoint and its Hydra config are selected together from this one name.
# "tiny" fits comfortably in 4 GB of VRAM; "base_plus" is more accurate and needs
# roughly 2.5 GB more. The matching .pt file must be present in MODELS_DIR or
# startup fails with an explicit error.
SAM_VARIANT=tiny

# CUDA device — leave empty for auto-detection (recommended)
# Set explicitly if auto-detection picks the wrong GPU.
CUDA_DEVICE=

# API server
HOST=127.0.0.1
PORT=8000
